{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memoryos:temporal-fact:0.3",
  "title": "MemoryOS Bi-temporal Fact",
  "type": "object",
  "additionalProperties": false,
  "required": ["fact_id", "project_id", "subject", "predicate", "object", "status", "recorded_at", "valid_from", "source_evidence_ids"],
  "properties": {
    "fact_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "predicate": {"type": "string", "minLength": 1},
    "object": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "superseded", "conflict", "expired"]},
    "observed_at": {"type": ["string", "null"], "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "supersedes_fact_id": {"type": ["string", "null"]},
    "source_memory_id": {"type": ["string", "null"]},
    "source_evidence_ids": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}

